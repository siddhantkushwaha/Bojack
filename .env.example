# Path to the SQLite database file.
# Local dev defaults to ./data/app.db if unset; the container sets /app/data/app.db.
DATABASE_PATH=

# Newsletter (Buttondown). Optional.
# Get a key at https://buttondown.com/settings/api
# Subscribers are always saved to SQLite; with a key set they're also
# forwarded to Buttondown so you can send the newsletter.
BUTTONDOWN_API_KEY=
